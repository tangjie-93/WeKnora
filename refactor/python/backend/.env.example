# WeKnora Python 后端环境变量（与仓库根目录 .env.example 对齐，仅列出当前阶段使用项）

# ========== 运行时 ==========
APP_HOST=0.0.0.0
APP_PORT=8080
LOG_LEVEL=info
TZ=Asia/Shanghai

# ========== 数据库 ==========
# postgres / sqlite
DB_DRIVER=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=WeKnora

# DB_DRIVER=sqlite 时使用
DB_PATH=./data/weknora.db

# 启动时自动执行迁移
AUTO_MIGRATE=true

# ========== Redis ==========
STREAM_MANAGER_TYPE=memory
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_PREFIX=stream:

# ========== 认证 ==========
# 留空则进程启动时随机生成（重启后旧 token 失效）
JWT_SECRET=
# AES-256 主密钥，32 字节；用于敏感字段落盘加密（Phase 2 起使用）
SYSTEM_AES_KEY=

# 注册模式：self_serve / invite_register / invite_only
WEKNORA_AUTH_REGISTRATION_MODE=self_serve

# ========== 文档解析（复用 docreader） ==========
DOCREADER_ADDR=localhost:50051
DOCREADER_TRANSPORT=grpc

# ========== 真实大模型（可选） ==========
# 填好后执行 `python scripts/seed_models.py` 写入默认 chat / embedding 模型并做连通性测试。
# 任何 OpenAI 兼容服务都可以，只需替换 base_url 与模型名。
# 示例（百炼）：https://dashscope.aliyuncs.com/compatible-mode/v1 + qwen-plus + text-embedding-v4
# 示例（DeepSeek）：https://api.deepseek.com/v1 + deepseek-chat（DeepSeek 无 embedding，需另配向量服务）
LLM_SEED_TENANT_ID=1

# 对话模型（默认）
LLM_CHAT_BASE_URL=
LLM_CHAT_MODEL=
LLM_CHAT_API_KEY=

# 第二个对话模型（非默认，用于同时挂 DeepSeek 与 ChatGPT）
LLM_CHAT2_BASE_URL=
LLM_CHAT2_MODEL=
LLM_CHAT2_API_KEY=

LLM_EMBEDDING_BASE_URL=
LLM_EMBEDDING_MODEL=
LLM_EMBEDDING_API_KEY=
# 必须与上游实际维度一致（OpenAI text-embedding-3-small=1536，百炼 v3=1024，bge-m3=1024）
LLM_EMBEDDING_DIMENSION=1024

# 访问 OpenAI 等境外服务时的 HTTP 代理（留空直连）
LLM_PROXY=

